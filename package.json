{
  "name": "hoorah",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @hoorah/web && npm run build -w @hoorah/server",
    "start": "npm run start -w @hoorah/server",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/sdk && tsc -p apps/server && tsc -p apps/web && tsc -p tools/assets",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
