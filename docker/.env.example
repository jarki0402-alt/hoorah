# Copy to docker/.env (ignored by git) to set these for `npm run docker:up`.

# Players in a room without a Hoorah Pass (free tier is 2).
MAX_PLAYERS=2

# First start only: creates this admin when the database has none yet. Leave empty and use the
# CLI instead (prints a generated password once):
#   docker compose -f docker/compose.yaml exec server node server.js admin set admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
